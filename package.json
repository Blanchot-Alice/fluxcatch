{
  "name": "havre",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=scripts/** --test-coverage-exclude=extension/background.js --test-coverage-lines=65 --test-coverage-functions=55 --test-coverage-branches=65 --test tests/*.test.js",
    "test:e2e": "node e2e/run.mjs",
    "package": "bash scripts/package.sh",
    "verify:package": "python3 scripts/verify_packages.py"
  }
}
