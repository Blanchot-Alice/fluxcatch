{
  "manifest_version": 3,
  "name": "FluxCatch",
  "description": "FluxCatch — Detect direct media, HLS and DASH streams and download them locally.",
  "version": "0.2.3",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "sidePanel",
    "storage",
    "webRequest"
  ],
  "optional_permissions": ["notifications", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FluxCatch",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
